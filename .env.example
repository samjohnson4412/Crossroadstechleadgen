# Copy to .env.local and fill in. Any integration left blank runs on the building simulator.

# Which site config to load (config/sites/*.ts)
SENTINEL_SITE=ccc
# Force every integration onto the simulator (demos)
# SENTINEL_SIMULATE=1

# Operator logins: name:password, comma separated. REQUIRED in production.
CONSOLE_USERS=

# Shared token vendor webhooks must send (?token=... or x-webhook-token header)
WEBHOOK_TOKEN=

# Blue Iris (cameras)
BLUEIRIS_URL=            # e.g. http://10.0.0.20:81
BLUEIRIS_USER=
BLUEIRIS_PASSWORD=

# Second Blue Iris server (optional — leave blank if there isn't one)
BLUEIRIS2_URL=
BLUEIRIS2_USER=
BLUEIRIS2_PASSWORD=

# UniFi Access (doors)
UNIFI_ACCESS_HOST=       # controller IP; API on port 12445
UNIFI_ACCESS_TOKEN=      # Access → Settings → General → Advanced → API Token
UNIFI_ACCESS_INSECURE_TLS=true

# SaferWatch (alerts)
SAFERWATCH_WEBHOOK_SECRET=
SAFERWATCH_OUTBOUND_URL=
SAFERWATCH_OUTBOUND_TOKEN=

# Algo paging adapter (overhead paging through the GoTo phones; horns)
ALGO_HOST=
ALGO_PASSWORD=
# ALGO_TONE_EMERGENCY=emergency.wav
# ALGO_TONE_WARNING=warning.wav
# ALGO_TONE_INFO=chime.wav
# ALGO_TTS=true

# Text messages (Twilio) — or fill these in on the Settings page
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# SMART Boards (messages)
SMART_SEND_URL=
SMART_TOKEN=
